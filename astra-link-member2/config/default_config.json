    "maximum_missed_frames": 5,
    "maximum_covariance_threshold": 100.0
  },
  "REACQUISITION": {
    "initial_search_radius": 0.1,
    "maximum_search_radius": 1.0,
    "levy_alpha": 1.5,
    "levy_min_step": 0.01,
    "levy_max_step": 0.5,
    "raster_grid_spacing": 0.1,
    "raster_search_radius": 1.0,
    "timeout": 10.0
  },
  "METRICS": {
    "enable_logging": true,
    "enable_ground_truth": false,
    "log_output_path": null,
    "plot_output_path": null
  }
}
